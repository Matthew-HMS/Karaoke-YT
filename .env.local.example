# Copy to .env.local and fill in. Everything here is optional — the app runs
# with an empty file, just with fewer features. Never commit .env.local.

# YouTube Data API v3 key — metadata for pasted links, chart-based top hits,
# and a fallback for search.
# Get one free: https://console.cloud.google.com/apis/credentials
#   1. Create a project, enable "YouTube Data API v3"
#   2. Create an API key, paste it below
# Pasting YouTube links works WITHOUT a key.
YOUTUBE_API_KEY=

# Optional: override the port the server listens on (default 3000).
# PORT=3000

# --- Google sign-in (Auth.js) ---
# Lets users sign in so favourites are personal. Optional — guests can still sing.
# 1. Generate a secret:  openssl rand -base64 32
AUTH_SECRET=
# 2. Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#    (Web application). Add authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://<your-public-domain>/api/auth/callback/google
#    Then paste the client id/secret here:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 3. Public base URL (REQUIRED behind a tunnel/proxy — the server binds 0.0.0.0,
#    which otherwise leaks into the OAuth callback). Set it to your public URL.
AUTH_URL=https://your-domain.example

# --- AI features (optional) ---
# Enables ✨ Ask AI in the Search tab, the Japanese reading aid (furigana /
# romaji) and lyrics translation. Uses an OpenAI-compatible gateway.
#
# SECURITY: this is the SERVER key — it is read only on the server and is NEVER
# sent to the browser. Do NOT prefix it with NEXT_PUBLIC_. (Users can also paste
# their OWN key in the in-app ⚙ Settings; that one stays on their device.)
# Get a key: https://www.orcarouter.ai
ORCAROUTER_API_KEY=
# Optional overrides — see the provider's model list for valid ids.
# ORCAROUTER_API_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_MODEL=
# ORCAROUTER_PAID_MODEL=
# ORCAROUTER_PAID_KEY=
# AI_FREE_LIMIT=

# Furigana is generated offline by a Japanese dictionary (no key, no quota).
# Set this to `llm` to go back to asking the model for it instead.
# FURIGANA_ENGINE=

# --- Lyrics ---
# Lyrics work out of the box with no key. Set a RapidAPI key to add a second
# source for songs the default one doesn't have.
# Get one: https://rapidapi.com/
RAPIDAPI_KEY=
# Optional host override for that provider:
# MUSIXMATCH_RAPIDAPI_HOST=

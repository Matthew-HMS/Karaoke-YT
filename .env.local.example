# Copy to .env.local and fill in.

# YouTube Data API v3 key — enables in-app search (Search tab).
# Get one free: https://console.cloud.google.com/apis/credentials
#   1. Create a project, enable "YouTube Data API v3"
#   2. Create an API key, paste it below
# Note: free quota is 10,000 units/day; each search costs ~100 units.
# Pasting YouTube links works WITHOUT a key.
YOUTUBE_API_KEY=

# Optional: override the port the server listens on (default 3000).
# PORT=3000

# --- Google sign-in (Auth.js) ---
# Lets users sign in so favorites are personal. Optional — guests can still sing.
# 1. Generate a secret:  openssl rand -base64 32
AUTH_SECRET=
# 2. Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#    (Web application). Add authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://<your-ngrok-static-domain>/api/auth/callback/google
#    Then paste the client id/secret here:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 3. Public base URL (REQUIRED behind a tunnel/proxy — our custom server binds
#    0.0.0.0, which otherwise leaks into the OAuth callback). Set to your public
#    URL, e.g. the ngrok static domain or, on the VM, your DuckDNS domain.
AUTH_URL=https://your-subdomain.ngrok-free.dev

# --- AI features via OrcaRouter (optional) ---
# Enables mood/natural-language song search (✨ Ask AI in the Search tab),
# Japanese romaji under lyrics, and smart lyrics cleanup for messy titles.
# OrcaRouter is an OpenAI-compatible gateway; we always use a FREE model, so
# this costs nothing (it's rate-limited, not billed).
#
# SECURITY: this is the SERVER default key — it is read only on the server and is
# NEVER sent to the browser. Do NOT prefix it with NEXT_PUBLIC_. (A user can also
# paste their OWN key in the in-app ⚙ Settings; that one lives on their device.)
# Get a key: https://www.orcarouter.ai  (join the OSS program for free access)
# Each FREE key is capped at ~50 requests/day. You can POOL several keys as a
# comma-separated list — requests fail over to the next key on 429, so N keys ≈
# N×50/day. Example: ORCAROUTER_API_KEY=sk-orca-aaa,sk-orca-bbb,sk-orca-ccc
ORCAROUTER_API_KEY=
# Optional overrides:
# ORCAROUTER_API_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_MODEL=orcarouter/free
# PAID FALLBACK (optional): a CREDITED key used only when the free pool above is
# exhausted or rate-limited, so the shared AI keeps working (costs ~$0.0002/song
# on the default cheap model). Leave blank to just degrade when free runs out.
# Like ORCAROUTER_API_KEY it may be a comma-separated list, and it NEVER reaches
# the browser. A user's own key never triggers this — it's your safety net only.
# ORCAROUTER_PAID_KEY=
# The model the paid fallback uses. Keep a fixed cheap model (our tasks are
# mechanical, so difficulty-routing like orcarouter-auto only adds cost/latency).
# ORCAROUTER_PAID_MODEL=deepseek/deepseek-v4-flash
# Free-use quota on the SHARED server key before a user must paste their own key
# (per Google account, or per device for guests). Default 5.
# AI_FREE_LIMIT=5
# A private "magic word" the deployer can type into the in-app key field to use
# the server key with NO quota (convenience for yourself). Leave blank to disable.
# AI_BYPASS_SECRET=

# --- Lyrics: Musixmatch fallback (optional) ---
# Lyrics use LRCLIB (free, no key) by default. Set a RapidAPI key to also fall
# back to the `musixmatch-lyrics-songs` provider when LRCLIB has nothing.
# Get one: https://rapidapi.com/  (free tier ~300 requests/month)
RAPIDAPI_KEY=
# Optional host override (defaults to musixmatch-lyrics-songs.p.rapidapi.com):
# MUSIXMATCH_RAPIDAPI_HOST=
